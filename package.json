{
  "name": "dsh-superagent-webhook-bridge",
  "version": "1.1.10",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./ui": {
      "types": "./lib/ui.d.ts",
      "default": "./lib/ui.js"
    }
  },
  "files": [
    "src",
    "lib",
    "scripts/integrate-ui.mjs",
    "cordis.patch.yml",
    "README.md",
    "docs/OPERATIONS.md",
    "LICENSE",
    "docs/DELIVERY-AUDIT.md",
    "scripts/install-host.mjs",
    "scripts/integrate-flow.mjs",
    "scripts/postinstall.mjs",
    "scripts/build.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:host": "node scripts/build-host-fixture.mjs && node --test tests/host.integration.js",
    "check": "node scripts/check.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test:package": "node scripts/package-smoke.mjs",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "re2-wasm": "1.0.2",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": "^0.2.1-alpha.2"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "license": "MIT",
  "description": "Reliable native Webhook source and event policies for DSH Super-agent",
  "bin": {
    "webhook-bridge-install": "scripts/install-host.mjs"
  }
}
